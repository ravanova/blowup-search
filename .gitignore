# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv
venv/
venv

# Headroom MCP server venv (dev tooling, rebuildable — see docs/HEADROOM.md)
.headroom-venv/
# Machine-local MCP registration — points at the uncommitted venv above; copy
# from .mcp.json.example instead of committing (a live .mcp.json would break
# every fresh/cloud clone)
.mcp.json

# Experiment outputs (see LOGGING.md) — logs/series/checkpoints are regenerated,
# not source. Tracked candidates get promoted explicitly, not via git.
experiments/run_logs/
experiments/*.jsonl
experiments/*.out

# Reference papers (copyrighted PDFs; grounding material, not source)
# Third-party PDFs are NOT committed -- but the manifest and fetch script ARE, so a
# rebuilt container can re-pull them in one command instead of losing them silently.
Papers/*
!Papers/MANIFEST.md
!Papers/fetch.sh

# OS / editor
.DS_Store
*.swp

# Transient local settings temp files
.claude/*.tmp.*
experiments/*.log
experiments/*.npz

# Orchestration: the live dashboard and the stop controls are LOCAL, never committed.
# PROGRESS.md is rewritten every cycle (the committed snapshot is reports/STATUS.md);
# the three stop files are how the user halts a continuous run (ORCHESTRATION.md §9).
PROGRESS.md
STOP
STOP-NOW
PAUSE

# Regenerated on demand by scripts/legs_over_time.py — output is stale the
# moment a new leg lands, so it's not a committed artifact.
reports/legs_over_time.html

# Agent worktrees created by subagent isolation
.claude/worktrees/
.leg*-work/
